# Example environment variables for the scheduling system

# Supabase public keys for the frontend
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google Sheets integration
GOOGLE_SHEET_ID=YOUR_SHEET_ID
VITE_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_SERVICE_ACCOUNT_FILE=public/service-account.json

# Local development only: do not commit service account credentials
# Create public/service-account.json locally and add it to .gitignore
