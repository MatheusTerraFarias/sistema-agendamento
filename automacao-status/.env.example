# ==========================================================
# AUTOMAÇÃO DE STATUS DE ORDENS DE SERVIÇO
# Copie este arquivo para .env e preencha os valores.
# ==========================================================

# ==== Google Sheets (planilha online) ====
# ID da planilha (parte da URL: https://docs.google.com/spreadsheets/d/SEU_ID/edit)
SPREADSHEET_ID=

# Nome da aba (opcional; usa a primeira aba se vazio)
SHEET_NAME=

# Conta de serviço criada no Google Cloud (IAM -> Contas de serviço).
# Compartilhe a planilha com esse e-mail como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternativa à chave acima: caminho para o JSON baixado da conta de serviço.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\credenciais.json

# Colunas de origem (opcional; por padrão são detectadas automaticamente)
# OS_COLUMN=Ordem de Serviço
# STATUS_COLUMN=Status da Atividade

# Nomes das colunas de saída (opcional)
# OUTPUT_STATUS_SINCRONIZADO_COLUMN=STATUS SINCRONIZADO
# OUTPUT_PRECISA_CONTATO_COLUMN=PRECISA CONTATO
# OUTPUT_DETALHE_STATUS_COLUMN=DETALHE STATUS
# OUTPUT_ULTIMA_SINCRONIZACAO_COLUMN=ULTIMA SINCRONIZACAO

# ==== Supabase (sistema de agendamento / base principal) ====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (Dashboard -> Settings -> API Keys).
# NUNCA exponha essa chave no front-end.
SUPABASE_SERVICE_ROLE_KEY=

# Espelhar status terminal (concluída/finalizada/cancelada) nos agendamentos?
# SYNC_BACK_TO_AGENDAMENTOS=true

# ==== Comportamento ====
# Intervalo de polling da planilha em segundos (padrão: 60)
# SYNC_INTERVAL_SECONDS=60
# Espera antes de executar após um disparo (padrão: 5000ms)
# DEBOUNCE_MS=5000
# Backoff máximo em ms após erros consecutivos (padrão: 300000)
# MAX_BACKOFF_MS=300000
# TZ=America/Sao_Paulo
